# Public browser variables. These are intentionally exposed in the Vite client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional public analytics configuration. The endpoint must be allowed by the CSP.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server-only variables. NEVER prefix these with VITE_ and never expose them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
FORGE_API_URL=
FORGE_API_KEY=
PORT=3000

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
APP_BASE_URL=
BILLING_MODE=mercadopago
MANUAL_PIX_FALLBACK_ENABLED=false
# Optional high-entropy URL secret for Mercado Pago subscription notification_url fallback when x-signature is unavailable.
MERCADO_PAGO_WEBHOOK_URL_SECRET=
# Local/non-production PostgreSQL URL used only by npm run test:billing:sql.
BILLING_SQL_TEST_DATABASE_URL=

# Google Drive notebooks (server-only). Generate a 32-byte Base64 encryption key.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
