# Public browser variables. These are intentionally exposed in the Vite client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional public analytics configuration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server-only variables. NEVER prefix these with VITE_ and never expose them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
FORGE_API_URL=
FORGE_API_KEY=
PORT=3000
